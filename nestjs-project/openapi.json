  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {}
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "nullable": true
          },
          "height": {
            "type": "number",
            "nullable": true
          },
          "videoCodec": {
            "type": "string",
            "nullable": true
          },
          "audioCodec": {
            "type": "string",
            "nullable": true
          },
          "formatName": {
            "type": "string",
            "nullable": true
          },
          "bitRate": {
            "type": "number",
            "nullable": true
          },
          "frameRate": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "width",
          "height",
          "videoCodec",
          "audioCodec",
          "formatName",
          "bitRate",
          "frameRate"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "aZ09bY18cX2"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "original_filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number"
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "processing_error": {
            "type": "string",
            "nullable": true
          },
          "stream_url": {
            "type": "string",
            "example": "/videos/aZ09bY18cX2/stream"
          },
          "download_url": {
            "type": "string",
            "example": "/videos/aZ09bY18cX2/download"
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "example": "/videos/aZ09bY18cX2/thumbnail"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "original_filename",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "metadata",
          "processing_error",
          "stream_url",
          "download_url",
          "thumbnail_url",
          "created_at",
          "updated_at"
        ]
      },
      "UploadPolicyDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "expires_in_seconds": {
            "type": "number",
            "example": 3600
          }
        },
        "required": [
          "part_size",
          "part_count",
          "expires_in_seconds"
        ]
      },
      "VideoUploadSessionDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPolicyDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number"
          },
          "url": {
            "type": "string",
            "description": "Presigned URL; PUT the part bytes to it."
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number"
          },
          "etag": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        },
        "required": [
          "part_number",
          "etag",
          "size"
        ]
      },
      "UploadPartsDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number"
          },
          "part_count": {
            "type": "number"
          },
          "expires_in_seconds": {
            "type": "number"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "uploaded_parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "expires_in_seconds",
          "parts",
          "uploaded_parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}