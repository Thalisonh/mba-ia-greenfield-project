    "/videos/{slug}/stream": {
      "get": {
        "description": "Progressive playback of a ready video. Honors a single-range Range header with 206 Partial Content.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "bytes=0-1048575"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole file"
          },
          "206": {
            "description": "The requested byte range"
          },
          "400": {
            "description": "Invalid slug",
            "content": {
              "video/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "video/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "The range cannot be satisfied",
            "content": {
              "video/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/download": {
      "get": {
        "description": "Sends the original file of a ready video as an attachment. Range requests allow resuming.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole file"
          },
          "206": {
            "description": "The requested byte range"
          },
          "400": {
            "description": "Invalid slug",
            "content": {
              "video/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "video/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "The range cannot be satisfied",
            "content": {
              "video/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    },
